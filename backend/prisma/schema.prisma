// DoctorPro - Prisma Schema
// Medical website management system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── Enums (SQLite doesn't support native enums, we use string fields) ───

// Role: ADMIN | DOCTOR | PATIENT
// AppointmentStatus: PENDING | CONFIRMED | COMPLETED | CANCELLED
// AppointmentType: NEW | FOLLOW_UP
// Gender: MALE | FEMALE | OTHER

// ─── Models ──────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      String   @default("ADMIN") // ADMIN | DOCTOR | DOCTOR_ASSISTANT
  status    String   @default("APPROVED") // APPROVED | PENDING_APPROVAL | REJECTED
  avatar    String?
  doctorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blogPosts BlogPost[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([doctorId])
}

model Doctor {
  id               String   @id @default(uuid())
  name             String
  title            String   @default("MBBS")
  slug             String   @unique
  specialization   String
  departmentId     String
  bio              String?
  image            String?
  certificate      String?
  slotDuration     Int      @default(30) // slot duration in minutes (10, 15, 20, 30, 45, 60)
  autoApprove      Boolean  @default(false) // auto-confirm online bookings
  appointmentStartTime String?  @default("09:00") // e.g. "09:00" / "17:00"
  appointmentEndTime   String?  @default("17:00") // e.g. "17:00" / "21:00"
  maxDailyPatients     Int      @default(20)
  experienceYears  Int      @default(0)
  education        String?  // JSON string
  chamberAddress   String?
  phone            String?
  email            String?
  consultationFee      Float    @default(0)
  currentServingSerial Int      @default(0) // Live chamber queue currently serving token
  chamberStatus        String   @default("ACTIVE") // ACTIVE | BREAK | CLOSED
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  department   Department    @relation(fields: [departmentId], references: [id])
  schedules    Schedule[]
  appointments Appointment[]

  @@index([slug])
  @@index([departmentId])
  @@index([specialization])
  @@index([isActive])
}

model Department {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors  Doctor[]
  services Service[]

  @@index([slug])
  @@index([isActive])
}

model Service {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  icon         String?
  departmentId String?
  price        Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])

  @@index([slug])
  @@index([departmentId])
  @@index([isActive])
}

model Schedule {
  id          String  @id @default(uuid())
  doctorId    String
  dayOfWeek   Int     // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime   String  // "09:00"
  endTime     String  // "17:00"
  maxPatients Int     @default(20)
  isActive    Boolean @default(true)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([dayOfWeek])
}

model Patient {
  id          String   @id @default(uuid())
  name        String
  phone       String
  email       String?
  address     String?
  dateOfBirth DateTime?
  gender      String?  // MALE | FEMALE | OTHER
  bloodGroup  String?
  userId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]

  @@index([phone])
  @@index([email])
}

model Appointment {
  id           String   @id @default(uuid())
  patientId    String
  doctorId     String
  date         DateTime
  timeSlot     String   // "09:00-09:30"
  serialNumber Int?     // Assigned queue token serial (1, 2, 3...)
  status       String   @default("PENDING") // PENDING | CONFIRMED | SERVING | COMPLETED | CANCELLED
  type         String   @default("NEW") // NEW | FOLLOW_UP
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([status])
  @@index([serialNumber])
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  image       String?
  category    String?
  tags        String?   // JSON string array
  authorId    String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([authorId])
  @@index([isPublished])
  @@index([category])
}

model Gallery {
  id        String   @id @default(uuid())
  title     String
  image     String
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([category])
  @@index([isActive])
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("general") // general | contact | social | seo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}

model Testimonial {
  id          String   @id @default(uuid())
  patientName String
  content     String
  rating      Int      @default(5) // 1-5
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([isActive])
  @@index([rating])
}
